# Database Provider — "supabase" (hosted) or "local" (future MariaDB support)
NEXT_PUBLIC_DB_PROVIDER=supabase

# Supabase — create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Agent Time on your local network — set this only on the TimeTracker VM.
# Example: the Agent Time PC is 10.40.40.10 and its service listens on port 8080.
AGENT_TIME_REMOTE_URL=http://10.40.40.10:8080/api/data

# Resend — optional, for sending invoice emails (https://resend.com)
RESEND_API_KEY=re_your_api_key

# Client-facing descriptions for Agent Time drafts. Uses the local Codex and Claude Code
# CLIs by default (AGENT_SUMMARY_PROVIDERS=codex,claude,api); the API key is only the last resort.
AGENT_SUMMARY_CODEX_MODEL=gpt-5.6-luna
AGENT_SUMMARY_CODEX_EFFORT=low
ANTHROPIC_API_KEY=
