# Database Provider — "supabase" (hosted) or "local" (future MariaDB support)
NEXT_PUBLIC_DB_PROVIDER=supabase

# Supabase — create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional collector URLs on your trusted network, or configure them in Settings.
# AGENT_TIME_REMOTE_URL=http://workstation.example:8080/api/data

# Resend — optional, for sending invoice emails (https://resend.com)
RESEND_API_KEY=re_your_api_key

# Interval titles use the authenticated Codex CLI on the TimeTracker server.
AGENT_SUMMARY_PROVIDERS=codex
AGENT_SUMMARY_CODEX_MODEL=gpt-5.6-terra
AGENT_SUMMARY_CODEX_EFFORT=low
ANTHROPIC_API_KEY=
