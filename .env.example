# Database Provider — "supabase" (hosted) or "local" (future MariaDB support)
NEXT_PUBLIC_DB_PROVIDER=supabase

# Supabase — create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Agent Time cloud relay — set these only in the server environment (never NEXT_PUBLIC_)
AGENT_TIME_REMOTE_URL=https://your-agent-time-relay.example/v1/snapshot
AGENT_TIME_API_KEY=your-private-agent-time-key

# Resend — optional, for sending invoice emails (https://resend.com)
RESEND_API_KEY=re_your_api_key
