[Unit]
Description=Build and deploy TimeTracker master with rollback
Wants=network-online.target
After=network-online.target pm2-root.service

[Service]
Type=oneshot
User=root
Environment=HOME=/root
Environment=PM2_HOME=/root/.pm2
ExecStart=/usr/local/sbin/timetracker-update
TimeoutStartSec=20min
TimeoutStopSec=90s
# PM2 runs in its own service; stop all updater build children on timeout.
KillMode=control-group
Nice=10
